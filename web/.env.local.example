# Copy to .env.local for local dev (gitignored). In production set these in Vercel.

# Google AI Studio key (server-side only — never exposed to the browser)
GEMINI_API_KEY=your-gemini-key
# Optional model override
GEMINI_MODEL=gemini-flash-latest

# The tunnel URL in front of the local Odoo proxy (e.g. ngrok)
ODOO_PROXY_URL=https://xxxx.ngrok-free.dev
# Must match proxy/.env ODOO_PROXY_TOKEN
ODOO_PROXY_TOKEN=your-proxy-token

# Passcode you give to whoever should access the chatbot
ACCESS_PASSCODE=set-a-passcode
